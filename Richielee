
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Richielee • Crypto Banking</title>
    <!-- Font Awesome 6 (free icons) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background: radial-gradient(circle at 30% 10%, #0b0f1c, #03050b);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 16px;
        }

        /* MAIN APP CARD – glassmorphism + subtle glow */
        .app-container {
            max-width: 1300px;
            width: 100%;
            background: rgba(12, 20, 30, 0.65);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(0, 255, 255, 0.12);
            border-radius: 48px;
            padding: 28px 32px;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(0, 255, 255, 0.05) inset, 0 0 40px rgba(0, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        /* HEADER – brand + global currency badge */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-icon {
            font-size: 2.5rem;
            background: linear-gradient(135deg, #00f2fe, #4facfe);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            filter: drop-shadow(0 0 12px #00e0ff);
        }

        .brand h1 {
            font-size: 2.2rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #ffffff, #b0e0ff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 0 0 20px rgba(0, 255, 255, 0.4);
        }

        .global-currency {
            background: rgba(0, 255, 255, 0.08);
            border: 1px solid rgba(0, 255, 255, 0.25);
            border-radius: 100px;
            padding: 8px 20px;
            font-size: 1rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 12px;
            color: #ccf0ff;
            box-shadow: 0 0 15px rgba(0, 255, 255, 0.1);
        }

        .global-currency i {
            font-size: 1.2rem;
            color: #00f2fe;
        }

        .currency-flags span {
            margin: 0 2px;
            font-size: 1.2rem;
        }

        /* BALANCE + QUICK STATS */
        .balance-section {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            background: rgba(0, 20, 30, 0.5);
            border-radius: 80px;
            padding: 18px 28px;
            border: 1px solid rgba(0, 255, 255, 0.1);
            backdrop-filter: blur(5px);
        }

        .balance-label {
            color: #8aa3b9;
            font-size: 0.9rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .balance-amount {
            font-size: 2.5rem;
            font-weight: 800;
            background: linear-gradient(135deg, #fff, #b0f0ff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            line-height: 1.2;
            letter-spacing: -1px;
        }

        .balance-amount small {
            font-size: 1.2rem;
            font-weight: 400;
            color: #7f9bb3;
            margin-left: 8px;
        }

        .quick-stats {
            display: flex;
            gap: 24px;
        }

        .stat-item {
            text-align: right;
        }

        .stat-label {
            font-size: 0.75rem;
            color: #6d8aa8;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-value {
            font-size: 1.3rem;
            font-weight: 600;
            color: #d0ecff;
        }

        .stat-value i {
            color: #00f2fe;
            margin-right: 5px;
        }

        /* MAIN GRID – transfer, features, card */
        .main-grid {
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: 24px;
        }

        /* LEFT PANEL – crypto transfer & assets */
        .transfer-panel {
            background: rgba(8, 18, 28, 0.65);
            border-radius: 32px;
            padding: 24px;
            border: 1px solid rgba(0, 255, 255, 0.1);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #b0e0ff;
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 20px;
            letter-spacing: 0.5px;
        }

        .section-title i {
            color: #00f2fe;
            font-size: 1.2rem;
        }

        /* crypto selector row */
        .crypto-options {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 25px;
        }

        .crypto-chip {
            background: rgba(0, 255, 255, 0.05);
            border: 1px solid rgba(0, 255, 255, 0.2);
            border-radius: 60px;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
            color: #b6d9f0;
            transition: all 0.2s;
            cursor: default;
            box-shadow: 0 0 10px rgba(0, 255, 255, 0.05);
        }

        .crypto-chip i {
            font-size: 1.3rem;
            color: #f0b90b;
        }

        .crypto-chip:nth-child(2) i {
            color: #26a17b;
        }

        .crypto-chip:nth-child(3) i {
            color: #627eea;
        }

        .crypto-chip .more-icon {
            color: #8aa3b9;
            font-size: 1rem;
        }

        .crypto-chip.active {
            background: rgba(0, 242, 254, 0.15);
            border-color: #00f2fe;
            box-shadow: 0 0 20px rgba(0, 242, 254, 0.3);
            color: white;
        }

        /* transfer form */
        .transfer-form {
            background: rgba(0, 0, 0, 0.25);
            border-radius: 24px;
            padding: 22px;
            margin-bottom: 20px;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 18px;
        }

        .input-group label {
            font-size: 0.8rem;
            color: #7f9bb3;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 500;
        }

        .input-row {
            display: flex;
            align-items: center;
            background: rgba(0, 20, 30, 0.7);
            border-radius: 18px;
            border: 1px solid rgba(0, 255, 255, 0.15);
            padding: 4px 18px;
            transition: 0.2s;
        }

        .input-row:focus-within {
            border-color: #00f2fe;
            box-shadow: 0 0 18px rgba(0, 242, 254, 0.2);
        }

        .input-row i {
            color: #00f2fe;
            font-size: 1.1rem;
            margin-right: 12px;
        }

        .input-row input {
            background: transparent;
            border: none;
            padding: 14px 0;
            font-size: 1rem;
            color: white;
            width: 100%;
            outline: none;
            font-weight: 500;
        }

        .input-row input::placeholder {
            color: #4a627a;
            font-weight: 400;
        }

        .input-row select {
            background: transparent;
            border: none;
            color: #00f2fe;
            font-weight: 600;
            font-size: 1rem;
            outline: none;
            cursor: pointer;
            padding: 14px 0;
            width: auto;
        }

        .input-row select option {
            background: #0b141e;
            color: white;
        }

        .transfer-btn {
            width: 100%;
            background: linear-gradient(135deg, #00c6fb, #005bea);
            border: none;
            border-radius: 60px;
            padding: 18px;
            font-size: 1.1rem;
            font-weight: 700;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            box-shadow: 0 10px 30px rgba(0, 120, 255, 0.4);
            transition: 0.2s;
            letter-spacing: 0.5px;
        }

        .transfer-btn:hover {
            transform: scale(1.01);
            box-shadow: 0 15px 35px rgba(0, 200, 255, 0.5);
        }

        .transfer-btn i {
            font-size: 1.2rem;
        }

        /* linked bank + support mini widgets */
        .quick-actions {
            display: flex;
            gap: 15px;
            margin-top: 10px;
        }

        .action-pill {
            background: rgba(0, 30, 45, 0.6);
            border: 1px solid rgba(0, 255, 255, 0.2);
            border-radius: 60px;
            padding: 14px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
            color: #c2d9f0;
            font-weight: 500;
            cursor: default;
            transition: 0.2s;
            backdrop-filter: blur(5px);
        }

        .action-pill i {
            color: #00f2fe;
            font-size: 1.2rem;
            width: 20px;
        }

        .action-pill span {
            font-size: 0.9rem;
        }

        .action-pill .badge {
            background: #00f2fe;
            color: #010b14;
            font-size: 0.6rem;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 40px;
            margin-left: auto;
            letter-spacing: 0.5px;
        }

        /* RIGHT PANEL – virtual card + chat */
        .right-panel {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        /* VIRTUAL CARD visual */
        .virtual-card {
            background: linear-gradient(135deg, #0b1b2b, #05111c);
            border-radius: 32px;
            padding: 24px;
            border: 1px solid rgba(0, 255, 255, 0.25);
            box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.8), 0 0 30px rgba(0, 180, 255, 0.2);
            position: relative;
            overflow: hidden;
        }

        .virtual-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(0, 242, 254, 0.25), transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .card-chip {
            width: 48px;
            height: 36px;
            background: linear-gradient(145deg, #d4af37, #b8860b);
            border-radius: 8px;
            margin-bottom: 20px;
            box-shadow: 0 0 15px rgba(255, 215, 0, 0.3);
        }

        .card-number {
            font-size: 1.4rem;
            letter-spacing: 3px;
            font-weight: 600;
            color: #e0f0ff;
            margin-bottom: 12px;
            text-shadow: 0 2px 5px black;
        }

        .card-details {
            display: flex;
            justify-content: space-between;
            color: #a0bedb;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 24px;
        }

        .card-details span {
            font-weight: 600;
            color: #c2e2ff;
            font-size: 0.9rem;
        }

        .card-apply-btn {
            background: rgba(0, 255, 255, 0.12);
            border: 1.5px solid #00f2fe;
            border-radius: 40px;
            padding: 14px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            color: #00f2fe;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            transition: 0.25s;
            backdrop-filter: blur(10px);
        }

        .card-apply-btn:hover {
            background: #00f2fe;
            color: #010b14;
            box-shadow: 0 0 30px #00f2fe;
        }

        /* chat support */
        .chat-support {
            background: rgba(8, 18, 28, 0.75);
            border-radius: 28px;
            padding: 22px;
            border: 1px solid rgba(0, 255, 255, 0.15);
            backdrop-filter: blur(8px);
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .chat-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
            color: #d0ecff;
        }

        .chat-header i {
            color: #00f2fe;
            font-size: 1.2rem;
        }

        .chat-messages {
            background: rgba(0, 10, 18, 0.6);
            border-radius: 20px;
            padding: 18px;
            margin-bottom: 16px;
            font-size: 0.9rem;
            color: #b0d0ea;
            flex: 1;
            min-height: 120px;
            border: 1px solid rgba(0, 255, 255, 0.1);
        }

        .message {
            display: flex;
            gap: 12px;
            margin-bottom: 14px;
        }

        .message-avatar {
            background: linear-gradient(135deg, #00c6fb, #005bea);
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: 700;
            color: white;
        }

        .message-bubble {
            background: rgba(0, 242, 254, 0.08);
            border-radius: 16px;
            padding: 10px 16px;
            border-left: 2px solid #00f2fe;
            max-width: 85%;
        }

        .message-bubble strong {
            color: #00f2fe;
        }

        .chat-input-row {
            display: flex;
            gap: 12px;
        }

        .chat-input-row input {
            flex: 1;
            background: rgba(0, 20, 30, 0.8);
            border: 1px solid rgba(0, 255, 255, 0.2);
            border-radius: 60px;
            padding: 14px 20px;
            color: white;
            outline: none;
            font-size: 0.9rem;
        }

        .chat-input-row input::placeholder {
            color: #5c7a94;
        }

        .chat-input-row button {
            background: linear-gradient(135deg, #00c6fb, #005bea);
            border: none;
            border-radius: 60px;
            width: 52px;
            color: white;
            font-size: 1.2rem;
            cursor: pointer;
            transition: 0.2s;
            box-shadow: 0 0 20px rgba(0, 150, 255, 0.4);
        }

        .chat-input-row button:hover {
            transform: scale(1.05);
        }

        /* responsive */
        @media (max-width: 900px) {
            .main-grid {
                grid-template-columns: 1fr;
            }
            .app-container {
                padding: 22px;
            }
            .balance-section {
                flex-direction: column;
                align-items: flex-start;
                gap: 16px;
            }
            .quick-stats {
                width: 100%;
                justify-content: space-between;
            }
        }

        @media (max-width: 500px) {
            .brand h1 {
                font-size: 1.6rem;
            }
            .global-currency {
                font-size: 0.8rem;
                padding: 6px 12px;
            }
            .balance-amount {
                font-size: 1.9rem;
            }
            .crypto-chip {
                padding: 8px 14px;
                font-size: 0.8rem;
            }
            .action-pill span {
                font-size: 0.75rem;
            }
        }

        /* tiny micro-interactions */
        .glow-text {
            text-shadow: 0 0 12px #00e0ff;
        }

        ::-webkit-scrollbar {
            width: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #00f2fe;
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <div class="app-container">
        <!-- HEADER -->
        <div class="header">
            <div class="brand">
                <i class="fas fa-coins brand-icon"></i>
                <h1>Richielee</h1>
            </div>
            <div class="global-currency">
                <i class="fas fa-globe"></i>
                <span>Global Currency</span>
                <div class="currency-flags">
                    <span>💵</span><span>💶</span><span>💷</span><span>💰</span>
                </div>
            </div>
        </div>

        <!-- BALANCE SECTION -->
        <div class="balance-section">
            <div>
                <div class="balance-label"><i class="fas fa-wallet" style="margin-right: 6px;"></i> Total portfolio</div>
                <div class="balance-amount">$28,459.80 <small>USD</small></div>
            </div>
            <div class="quick-stats">
                <div class="stat-item">
                    <div class="stat-label">BTC</div>
                    <div class="stat-value"><i class="fab fa-bitcoin"></i> 0.42</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">ETH</div>
                    <div class="stat-value"><i class="fab fa-ethereum"></i> 3.8</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">USDT</div>
                    <div class="stat-value"><i class="fas fa-dollar-sign"></i> 5,200</div>
                </div>
            </div>
        </div>

        <!-- MAIN GRID -->
        <div class="main-grid">
            <!-- LEFT PANEL -->
            <div class="transfer-panel">
                <div class="section-title">
                    <i class="fas fa-paper-plane"></i> Transfer crypto · BTC, USDT, ETH & more
                </div>
                <!-- crypto chips -->
                <div class="crypto-options">
                    <div class="crypto-chip active"><i class="fab fa-bitcoin"></i> BTC</div>
                    <div class="crypto-chip"><i class="fas fa-dollar-sign" style="color: #26a17b;"></i> USDT</div>
                    <div class="crypto-chip"><i class="fab fa-ethereum"></i> ETH</div>
                    <div class="crypto-chip"><i class="fas fa-plus-circle more-icon"></i> More</div>
                </div>

                <!-- transfer form -->
                <div class="transfer-form">
                    <div class="input-group">
                        <label>Recipient address</label>
                        <div class="input-row">
                            <i class="fas fa-qrcode"></i>
                            <input type="text" placeholder="0x... or wallet address" value="0x7Fc...3a9E">
                        </div>
                    </div>
                    <div class="input-group">
                        <label>Amount</label>
                  
